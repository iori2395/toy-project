# Copy to .env.local and fill in from Supabase Dashboard > Project Settings > API Keys.
# Both values are sent to the browser. Never put a secret or service_role key here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gyeonggi Data Dream (data.gg.go.kr) Open API key for the popular loan ranking.
# Server-only: keep it without the NEXT_PUBLIC_ prefix.
GYEONGGI_OPENAPI_KEY=
